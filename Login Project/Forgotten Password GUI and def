# "Forgotten my passowrd" Reset Menu
def ForgottenMenu():
    reset_codes = {}

    ForgottenApp = Window(app, title="Forgotten Password", height=400, width=400, bg="#d3d3d3")

    ForgottenMenuExitBox = Box(ForgottenApp, width="fill", align="top")
    ForgottenMenuExitButton = PushButton(ForgottenMenuExitBox, text="Cancel", align="left", command=ForgottenApp.hide)
    ForgottenMenuExitButton.bg = "#d3d3d3"

    Text(ForgottenApp, text="Please enter your email to reset password:", size=12)

    # Email input
    email_box = Box(ForgottenApp, layout="grid")
    Text(email_box, text="Email:", grid=[0,0], align="left")
    email_input = TextBox(email_box, grid=[1,0], width=30)

    # Result / status text
    result_text = Text(ForgottenApp, text="", size=12, color="red")

    # --- Widgets for code + new password input ---
    Text(ForgottenApp, text="Enter the reset code sent to your email:", size=12)
    code_input = TextBox(ForgottenApp, width=20)

    Text(ForgottenApp, text="Enter new password:", size=12)
    new_pw_input = TextBox(ForgottenApp, hide_text=True, width=20)

    Text(ForgottenApp, text="Confirm new password:", size=12)
    confirm_pw_input = TextBox(ForgottenApp, hide_text=True, width=20)

    # Result / status text
    ForgottenErrors = Text(ForgottenApp, text="", size=12, color="red")

    def send_reset_code():
        entered_email = email_input.value.strip()
        if entered_email == "":
            ForgottenErrors.value = "Please enter an email."
            return

        query = "SELECT * FROM User WHERE user_email = ?"
        rows = query_database(database_file, query, (entered_email,))

        if len(rows) == 0:
            ForgottenErrors.value = "Email not found in database."
        else:
            # Generate and store code
            code = random.randint(100000, 999999)
            reset_codes[entered_email] = str(code)  # Store as string for easy comparison

            # In real app: send code by email. Here we display it for testing.
            result_text.value = f"Reset code sent: {code}"

            submit_email_btn.tk.config(state=tk.DISABLED)



    def reset_password():
        entered_email = email_input.value.strip()
        entered_code = code_input.value.strip()
        new_pw = new_pw_input.value.strip()
        confirm_pw = confirm_pw_input.value.strip()

        if entered_email == "" or entered_code == "" or new_pw == "" or confirm_pw == "":
            ForgottenErrors.value = "No reset code requested for this email."
            return

        # Check code matches stored code
        if entered_email not in reset_codes:
            ForgottenErrors.value = "No reset code requested for this email."
            return

        if reset_codes[entered_email] != entered_code:
            ForgottenErrors.value = "Invalid reset code."
            return

        # Check passwords match
        if new_pw != confirm_pw:
            ForgottenErrors.value = "Passwords do not match."
            return

        # Update password in DB
        update_query = "UPDATE User SET user_password = ? WHERE user_email = ?"
        execute_sql(database_file, update_query, (new_pw, entered_email))

        # Remove used code
        del reset_codes[entered_email]

        info("Success", "Password successfully reset!")

       
     
       

    submit_email_btn = PushButton(ForgottenApp, text="Send Reset Code", command=send_reset_code)
    reset_pw_btn = PushButton(ForgottenApp, text="Reset Password", command=reset_password)
